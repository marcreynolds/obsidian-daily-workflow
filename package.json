{
  "name": "obsidian-daily-workflow",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
